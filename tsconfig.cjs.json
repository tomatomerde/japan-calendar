{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // package.json の "type": "module" により、tsc はソースツリー全体を ESM だと
    // みなす（impliedNodeFormat）。verbatimModuleSyntax を有効にしたままだと
    // CommonJS 出力先でもそのESM判定と矛盾してエラーになるため、この
    // プロジェクトだけ無効化する。import/export の書き方自体はESM版と共通。
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    // CJS 利用者向けに .d.ts を dist/cjs にも出力する。dist/cjs/package.json
    // (ビルド時に生成、{"type":"commonjs"}) が最も近い package.json になるため、
    // TypeScript の node16/nodenext 解決はここに置いた .d.ts を CJS 用の
    // 型定義として扱う。exports の "require" 条件がこちらを指すことで、
    // ESM/CJS どちらの利用者にも正しい形式の型定義を届けられる
    // （require() 利用者に ESM 用 .d.ts を渡す "false ESM" を防ぐ）。
    "declaration": true,
    "outDir": "dist/cjs",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src"]
}
